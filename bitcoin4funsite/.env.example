# Nonsecret deployment settings. Copy to .env and fill values locally.
BTC_DB_HOST=nextcloud-aio-database
BTC_DB_PORT=5432
BTC_DB_NAME=d_bitcoin4fun
BTC_DB_USER=bitcoin4fun_web_ro
BTC_DB_PASSWORD_FILE=./secrets/db_password
BTC_DB_NETWORK=nextcloud-aio
BITCOIN4FUN_BIND_PORT=18084
BITCOIN4FUN_IMAGE=bitcoin4fun:local
BTC_MARKET_ENV_FILE=./secrets/market.env
BTC_CONTACT_ENV_FILE=./secrets/contact.env
BTC_CONTACT_STATE_DIR=./state
# secrets/contact.env: CONTACT_SECRET, BTC_CONTACT_NTFY_TOKEN and
# CONTACT_STATE_FILE=/var/lib/btc4fun/contact.sqlite3. Never commit real values.
# Create state/ as UID/GID 1000, mode 0700; contact envfile mode 0600.
# secrets/market.env contains SWAPWALLET_API_TOKEN and must have mode 0600.
# LOOKUP_STATE_FILE defaults to /var/lib/btc4fun/lookup.sqlite3.
# Lookup admission uses the existing CONTACT_SECRET; no new secret is needed.
